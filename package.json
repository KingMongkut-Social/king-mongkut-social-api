{
  "name": "king-mongkut-social-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "//_old_dev": "tsx watch src/server.ts",
    "dev": "tsx watch src/server.ts | pino-pretty -c",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:indexes": "node dist/scripts/sync-indexes.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:indexes:dev": "tsx src/scripts/sync-indexes.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "mongoose": "9.9.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.35.0",
    "pino-pretty": "^13.1.3",
    "supertest": "7.1.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
