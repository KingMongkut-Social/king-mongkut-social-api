NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/king_mongkut_social
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-different-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
LOG_LEVEL=info

# Google Identity Services OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
