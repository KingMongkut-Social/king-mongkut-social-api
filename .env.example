NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/king_mongkut_social
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-different-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax # development/test; production refresh cookie is forced to SameSite=None
TRUST_PROXY=0
LOG_LEVEL=info
UPLOAD_DIR=uploads

# Google OAuth web application (secret stays on the API only)
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
